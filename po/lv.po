#: panel-plugin/main.c:181
#, c-format
msgid "%s: Device statistics unavailable."
msgstr "%s: ierīces statistika nav pieejama."

#: panel-plugin/main.c:221
#, c-format
msgid ""
"I/O (MiB/s)\n"
"  Read: %3.2f\n"
"  Write: %3.2f\n"
"  Total: %3.2f\n"
"Busy time (%c)\n"
msgstr "I/O (MiB/s)\n  Lasīšana: %3.2f\n  Rakstīšana: %3.2f\n  Kopā: %3.2f\nAizņemtais laiks (%c)\n"

#: panel-plugin/main.c:227
#, c-format
msgid ""
"  Read: %d\n"
"  Write: %d\n"
msgstr "  Lasīšana: %d\n  Rakstīšana: %d\n"

#: panel-plugin/main.c:230
#, c-format
msgid "  Total: %d"
msgstr "  Kopā: %d"

#: panel-plugin/main.c:821
#, c-format
msgid ""
"%s\n"
"%s: %s (%d)\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s\n%s: %s (%d)\n\nŠis pārraugs nedarbosies!\nLūdzu, noņemiet to."

#: panel-plugin/main.c:832
#, c-format
msgid ""
"%s: No disk extended statistics found!\n"
"Either old kernel (< 2.4.20) or not\n"
"compiled with CONFIG_BLK_STATS turned on.\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s: nav atrasta diska paplašinātā statistika!\nVai nu vecs kodols (< 2.4.20), vai tas nav\nkompilēts ar ieslēgtu CONFIG_BLK_STATS.\n\nŠis pārraugs nedarbosies!\nLūdzu, noņemiet to."

#: panel-plugin/main.c:840
#, c-format
msgid ""
"%s: Unknown error\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s: nezināma kļūda\n\nŠis pārraugs nedarbosies!\nLūdzu, noņemiet to."

#: panel-plugin/main.c:864
msgid ""
"Diskperf monitor displays instantaneous disk I/O transfer rates and busy "
"times"
msgstr "Diskperf pārraugs rāda diska I/O pārsūtīšanas ātrumu un aizņemtības laiku reāllaikā"

#: panel-plugin/main.c:897 panel-plugin/diskperf.desktop.in:5
msgid "Disk Performance Monitor"
msgstr "Diska veiktspējas pārraugs"

#: panel-plugin/main.c:900
msgid "_Close"
msgstr "_Aizvērt"

