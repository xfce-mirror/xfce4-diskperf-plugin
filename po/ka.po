msgstr ""

#: panel-plugin/main.c:821
#, c-format
msgid ""
"%s\n"
"%s: %s (%d)\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s\n%s: %s (%d)\n\nეს მონიტორი არ იმუშავებს!\nწაშლაეთ."

#: panel-plugin/main.c:832
#, c-format
msgid ""
"%s: No disk extended statistics found!\n"
"Either old kernel (< 2.4.20) or not\n"
"compiled with CONFIG_BLK_STATS turned on.\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s: დისკის გაფართოებული სტატისტიკა აღმოჩენილი არაა!\nან ბირთვი ძველია (< 2.4.0) ან დაკომპილებული არააა\nჩართული ალმით CONFIG_BLK_STATS.\n\nეს მონიტორი არ იმუშავებს!\nწაშალეთ ის."

#: panel-plugin/main.c:840
#, c-format
msgid ""
"%s: Unknown error\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s უცნობი შეცდომა\n\nეს მონიტორი არ იმუშავებს!\nწაშალეთ ის."

#: panel-plugin/main.c:864
msgid ""
"Diskperf monitor displays instantaneous disk I/O transfer rates and busy "
"times"
msgstr "Diskperf-ის მონიტორი აჩვენებს უეცარი დისკის i/o გადაცემის სიჩქარეებს და დაკავებულობის დროებს"

