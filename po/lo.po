msgstr "ຕົວຕິດຕາມ \"ການອ່ານ\" ກ່ອນ"

#: panel-plugin/config_gui.c:256
msgid "Write-Read"
msgstr "ຂຽນ-ອ່ານ"

#: panel-plugin/config_gui.c:259
msgid "\"Write\" monitor first"
msgstr "ຕົວຕິດຕາມ \"ການຂຽນ\" ກ່ອນ"

#: panel-plugin/main.c:188
#, c-format
msgid "%s: Device statistics unavailable."
msgstr "%s: ບໍ່ມີຂໍ້ມູນສະຖິຕິຂອງອຸປະກອນ."

#: panel-plugin/main.c:227
#, c-format
msgid ""
"%s\n"
"----------------\n"
"I/O (MiB/s)\n"
"  Read: %3.2f\n"
"  Write: %3.2f\n"
"  Total: %3.2f\n"
"Busy time (%c)\n"
"  Read: %d\n"
"  Write: %d\n"
"  Total: %d"
msgstr "%s\n----------------\nI/O (MiB/s)\n  ອ່ານ: %3.2f\n  ຂຽນ: %3.2f\n  ທັງໝົດ: %3.2f\nເວລາທີ່ເຮັດວຽກ (%c)\n  ອ່ານ: %d\n  ຂຽນ: %d\n  ທັງໝົດ: %d"

#: panel-plugin/main.c:823
#, c-format
msgid ""
"%s\n"
"%s: %s (%d)\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s\n%s: %s (%d)\n\nຕົວຕິດຕາມນີ້ຈະບໍ່ເຮັດວຽກ!\nກະລຸນາລຶບມັນອອກ."

#: panel-plugin/main.c:834
#, c-format
msgid ""
"%s: No disk extended statistics found!\n"
"Either old kernel (< 2.4.20) or not\n"
"compiled with CONFIG_BLK_STATS turned on.\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s: ບໍ່ພົບຂໍ້ມູນສະຖິຕິເພີ່ມເຕີມຂອງດິດ!\nອາດເປັນຍ້ອນ ເຄີເນວ (kernel) ຮຸ່ນເກົ່າ (< 2.4.20) ຫຼື ບໍ່ໄດ້\nຄອມໄພລ໌ (compiled) ໂດຍເປີດໃຊ້ CONFIG_BLK_STATS.\n\nຕົວຕິດຕາມນີ້ຈະບໍ່ເຮັດວຽກ!\nກະລຸນາລຶບມັນອອກ."

#: panel-plugin/main.c:842
#, c-format
msgid ""
"%s: Unknown error\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s: ຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ\n\nຕົວຕິດຕາມນີ້ຈະບໍ່ເຮັດວຽກ!\nກະລຸນາລຶບມັນອອກ."

#: panel-plugin/main.c:866
msgid ""
"Diskperf monitor displays instantaneous disk I/O transfer rates and busy "
"times"
msgstr "ຕົວຕິດຕາມ Diskperf ສະແດງອັດຕາການຮັບ-ສົ່ງຂໍ້ມູນ I/O ຂອງດິດ ແລະ ເວລາທີ່ເຮັດວຽກໃນຂະນະນັ້ນ"

#: panel-plugin/main.c:899 panel-plugin/diskperf.desktop.in:5
msgid "Disk Performance Monitor"
msgstr "ຕົວຕິດຕາມປະສິດທິພາບຂອງດິດ"

#: panel-plugin/main.c:902
msgid "_Close"
msgstr "_ປິດ"

#: panel-plugin/diskperf.desktop.in:6
msgid "Show disk performance"
msgstr "ສະແດງປະສິດທິພາບຂອງດິດ"
