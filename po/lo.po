#: panel-plugin/config_gui.c:184
msgid "Input the maximum I/O transfer rate of the device, then press <Enter>"
msgstr "ປ້ອນອັດຕາການຮັບ-ສົ່ງ I/O ສູງສຸດຂອງອຸປະກອນ, ແລ້ວກົດ <Enter>"

#: panel-plugin/config_gui.c:186
msgid "35"
msgstr "35"

