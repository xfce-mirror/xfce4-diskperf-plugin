#: panel-plugin/main.c:181
#, c-format
msgid "%s: Device statistics unavailable."
msgstr "%s: gailuaren estatistikak ez daude eskuragarri."

#: panel-plugin/main.c:221
#, c-format
msgid ""
"I/O (MiB/s)\n"
"  Read: %3.2f\n"
"  Write: %3.2f\n"
"  Total: %3.2f\n"
"Busy time (%c)\n"
msgstr "S/I (MiB/s)\n  Irakurketa: %3.2f\n  Idazketa: %3.2f\n  Guztira: %3.2f\nOkupazio-denbora (%c)\n"

#: panel-plugin/main.c:227
#, c-format
msgid ""
"  Read: %d\n"
"  Write: %d\n"
msgstr "  Irakurketa: %d\n  Idazketa: %d\n"

#: panel-plugin/main.c:230
#, c-format
msgid "  Total: %d"
msgstr "  Guztira: %d"

#: panel-plugin/main.c:821
#, c-format
msgid ""
"%s\n"
"%s: %s (%d)\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s\n%s: %s (%d)\n\nMonitore honek ez du funtzionatuko!\nMesedez, kendu ezazu."

#: panel-plugin/main.c:832
#, c-format
msgid ""
"%s: No disk extended statistics found!\n"
"Either old kernel (< 2.4.20) or not\n"
"compiled with CONFIG_BLK_STATS turned on.\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s: Ez da diskoaren estatistika hedaturik aurkitu!\nKernela zaharra da (< 2.4.20) edo ez da\nCONFIG_BLK_STATS gaituta konpilatu.\n\nMonitore honek ez du funtzionatuko!\nMesedez, kendu ezazu."

#: panel-plugin/main.c:840
#, c-format
msgid ""
"%s: Unknown error\n"
"\n"
"This monitor will not work!\n"
"Please remove it."
msgstr "%s: Errore ezezaguna\n\nMonitore honek ez du funtzionatuko!\nMesedez, kendu ezazu."

#: panel-plugin/main.c:864
msgid ""
"Diskperf monitor displays instantaneous disk I/O transfer rates and busy "
"times"
msgstr "Diskperf monitoreak diskoaren uneko S/I transferentzia-tasak eta okupazio-denborak bistaratzen ditu"

#: panel-plugin/main.c:897 panel-plugin/diskperf.desktop.in:5
msgid "Disk Performance Monitor"
msgstr "Diskoaren errendimendu-monitorea"

#: panel-plugin/main.c:900
msgid "_Close"
msgstr "_Itxi"

#: panel-plugin/diskperf.desktop.in:6
msgid "Show disk performance"
msgstr "Erakutsi diskoaren errendimendua"
