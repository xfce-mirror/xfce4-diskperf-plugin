msgstr "ໝາຍຕິກເພື່ອສະແດງປ້າຍຊື່"

#: panel-plugin/config_gui.c:137
msgid "Input the label, then press <Enter>"
msgstr "ປ້ອນປ້າຍຊື່, ແລ້ວກົດ <Enter>"

#: panel-plugin/config_gui.c:139
msgid "hda1"
msgstr "hda1"

