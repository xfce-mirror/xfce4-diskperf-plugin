msgstr "ສີແທ່ງການອ່ານ "

#: panel-plugin/config_gui.c:235
msgid "Write bar color "
msgstr "ສີແທ່ງການຂຽນ "

#: panel-plugin/config_gui.c:242
msgid "Bar order"
msgstr "ລຳດັບຂອງແທ່ງ"

